---
interface Props {
  /** Compact inline badge vs. fuller demo callout */
  variant?: 'badge' | 'callout';
}

const { variant = 'callout' } = Astro.props;

const respectifyUrl = 'https://respectify.ai';
const demoUrl = 'https://demo.respectify.ai';
---

<div class:list={['powered-by-respectify', variant === 'badge' && 'powered-by-respectify--badge', variant === 'callout' && 'mb-6']}>
  {
    variant === 'callout' ? (
      <div class="rounded-lg border border-accent/30 bg-accent/5 px-4 py-3 dark:border-accent/40 dark:bg-accent/10">
        <div class="flex flex-wrap items-start justify-between gap-3">
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold text-accent-2">
              <a class="cactus-link inline-flex items-center gap-1.5 hover:text-link" href={respectifyUrl} rel="noopener noreferrer" target="_blank">
                <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                  <path d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                Powered by Respectify
              </a>
            </p>
            <p class="mt-1 text-sm text-gray-700 dark:text-gray-300">
              Comments on this site are analyzed in real time for spam and respectfulness before they appear. Try leaving a comment to see it in action.
            </p>
          </div>
          <a class="shrink-0 rounded-md border border-accent/40 px-3 py-1.5 text-xs font-medium text-accent-2 transition hover:border-accent hover:bg-accent/10" href={demoUrl} rel="noopener noreferrer" target="_blank">
            Try the demo →
          </a>
        </div>
      </div>
    ) : (
      <a class="inline-flex items-center gap-1.5 text-xs text-gray-600 transition hover:text-accent-2 dark:text-gray-400" href={respectifyUrl} rel="noopener noreferrer" target="_blank">
        <svg aria-hidden="true" class="h-3.5 w-3.5 text-accent" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Powered by Respectify
      </a>
    )
  }
</div>
