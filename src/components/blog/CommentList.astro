---
interface Props {
  postSlug: string;
}

const { postSlug } = Astro.props;
---

<div class="comments-section mt-8" data-post-slug={postSlug}>
  <h3 class="text-2xl font-bold mb-6">
    Comments (<span class="comment-count">…</span>)
  </h3>

  <div class="comments-loading text-gray-600 dark:text-gray-400 italic">Loading comments…</div>

  <div class="comments-list hidden space-y-6"></div>

  <p class="comments-empty hidden text-gray-600 dark:text-gray-400 italic">No comments yet. Be the first to comment!</p>
</div>

<script>
  import { actions } from 'astro:actions';
  import { checkAuth } from '../../lib/client/auth-check';
  import { fetchComments, renderCommentHtml } from '../../lib/client/comments';

  function setupDeleteControls(isAdmin: boolean): void {
    if (!isAdmin) return;

    const controlGroups = document.querySelectorAll('.delete-controls');

    controlGroups.forEach((group) => {
      if (group.getAttribute('data-delete-bound') === 'true') return;
      group.setAttribute('data-delete-bound', 'true');

      group.classList.remove('hidden');
      group.classList.add('inline-flex');

      const deleteBtn = group.querySelector('.delete-comment-btn') as HTMLButtonElement;
      const confirmSpan = group.querySelector('.delete-confirm') as HTMLSpanElement;
      const confirmBtn = group.querySelector('.confirm-delete-btn') as HTMLButtonElement;
      const cancelBtn = group.querySelector('.cancel-delete-btn') as HTMLButtonElement;
      const errorSpan = group.querySelector('.delete-error') as HTMLSpanElement;

      if (!deleteBtn || !confirmSpan || !confirmBtn || !cancelBtn || !errorSpan) return;

      deleteBtn.addEventListener('click', () => {
        deleteBtn.classList.add('hidden');
        confirmSpan.classList.remove('hidden');
        confirmSpan.classList.add('inline-flex');
        errorSpan.classList.add('hidden');
      });

      cancelBtn.addEventListener('click', () => {
        confirmSpan.classList.add('hidden');
        confirmSpan.classList.remove('inline-flex');
        deleteBtn.classList.remove('hidden');
      });

      confirmBtn.addEventListener('click', async () => {
        const commentId = parseInt(confirmBtn.dataset.commentId || '0', 10);
        if (!commentId) return;

        confirmBtn.disabled = true;
        confirmBtn.textContent = 'Deleting...';

        const { error } = await actions.comments.delete({ commentId });

        if (error) {
          errorSpan.textContent = 'Failed to delete comment';
          errorSpan.classList.remove('hidden');
          confirmSpan.classList.add('hidden');
          confirmSpan.classList.remove('inline-flex');
          deleteBtn.classList.remove('hidden');
          confirmBtn.disabled = false;
          confirmBtn.textContent = 'Yes, delete';
          return;
        }

        const commentEl = document.querySelector(`[data-comment-id="${commentId}"]`);
        commentEl?.remove();

        const section = document.querySelector('.comments-section');
        const countEl = section?.querySelector('.comment-count');
        if (countEl) {
          const currentCount = parseInt(countEl.textContent || '0', 10);
          countEl.textContent = String(Math.max(currentCount - 1, 0));
        }

        const listEl = section?.querySelector('.comments-list');
        const emptyEl = section?.querySelector('.comments-empty');
        if (listEl && listEl.children.length === 0) {
          listEl.classList.add('hidden');
          emptyEl?.classList.remove('hidden');
        }
      });
    });
  }

  async function loadComments(section: HTMLElement): Promise<void> {
    const postSlug = section.dataset.postSlug || '';
    const loadingEl = section.querySelector('.comments-loading') as HTMLElement;
    const listEl = section.querySelector('.comments-list') as HTMLElement;
    const emptyEl = section.querySelector('.comments-empty') as HTMLElement;
    const countEl = section.querySelector('.comment-count') as HTMLElement;

    try {
      const comments = await fetchComments(postSlug);

      loadingEl.classList.add('hidden');
      countEl.textContent = String(comments.length);

      if (comments.length === 0) {
        emptyEl.classList.remove('hidden');
        return;
      }

      listEl.innerHTML = comments.map((comment) => renderCommentHtml(comment)).join('');
      listEl.classList.remove('hidden');

      const isAdmin = await checkAuth();
      setupDeleteControls(isAdmin);
    } catch {
      loadingEl.textContent = 'Unable to load comments.';
    }
  }

  const section = document.querySelector('.comments-section') as HTMLElement | null;
  if (section) {
    void loadComments(section);

    window.addEventListener('comment-published', (event) => {
      const detail = (event as CustomEvent<{ postSlug: string }>).detail;
      if (detail?.postSlug === section.dataset.postSlug) {
        const emptyEl = section.querySelector('.comments-empty');
        const listEl = section.querySelector('.comments-list');
        emptyEl?.classList.add('hidden');
        listEl?.classList.remove('hidden');
        void loadComments(section);
      }
    });
  }
</script>
