---
import '@styles/everyday.css';
---

<figure class="everyday everyday-venn not-prose">
  <svg viewBox="0 0 300 300" role="img" aria-label="The four-circle Venn diagram popular in the West: what you love, what you are good at, what the world needs and what you can be paid for, with ikigai in the middle">
    <g fill-opacity=".16" stroke-width="1.5">
      <circle class="everyday-venn-love" cx="150" cy="100" r="72"></circle>
      <circle class="everyday-venn-good" cx="100" cy="150" r="72"></circle>
      <circle class="everyday-venn-needs" cx="200" cy="150" r="72"></circle>
      <circle class="everyday-venn-paid" cx="150" cy="200" r="72"></circle>
    </g>
    <g font-size="11.5" text-anchor="middle" fill="currentColor">
      <text x="150" y="56">What you love</text>
      <text x="58" y="154">Good at</text>
      <text x="242" y="154">World needs</text>
      <text x="150" y="252">Paid for</text>
      <text x="150" y="154" font-weight="700">"ikigai"</text>
    </g>
  </svg>
  <figcaption>The Western Venn, popularized in 2014</figcaption>
</figure>
