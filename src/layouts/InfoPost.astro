---
import type { CollectionEntry, RenderResult } from 'astro:content';
import TOC from '@components/blog/TOC.astro';
import BackToTop from '@components/BackToTop.astro';
import BaseLayout from './Base.astro';

interface Props {
  info: CollectionEntry<'info'>;
  headings: RenderResult['headings'];
}

const { info, headings } = Astro.props;
const {
  data: { ogImage, title },
  id,
} = info;
const socialImage = ogImage ?? `/og-image/${id}.png`;
---

<BaseLayout meta={{ ogImage: socialImage, title }}>
  <div class="gap-x-10 lg:flex lg:items-start">
    {!!headings.length && <TOC headings={headings} />}
    <article id="info-content" class="flex-grow break-words" data-pagefind-body>
      <div class="prose prose-cactus mt-12 max-w-3xl prose-headings:font-semibold prose-headings:text-accent-2 prose-headings:before:absolute prose-headings:before:-ms-4 prose-headings:before:text-accent prose-headings:before:content-['#'] prose-th:before:content-none">
        <slot />
      </div>
    </article>
  </div>

  <BackToTop observeId="info-content" />
</BaseLayout>
