{
  "name": "nickhodgesblog",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "build:ci": "astro build",
    "db:local": "mkdir -p .data && drizzle-kit push --config drizzle.local.config.ts",
    "build:check": "astro check && astro build",
    "lint": "prettier --check \"**/*.{js,jsx,ts,tsx,md,mdx,astro}\" && eslint \"src/**/*.{js,ts,jsx,tsx,astro}\"",
    "lint:fix": "prettier --write \"**/*.{js,jsx,ts,tsx,md,mdx,astro}\" && eslint --fix \"src/**/*.{js,ts,jsx,tsx,astro}\"",
    "prebuild:check": "npm run lint",
    "postbuild": "pagefind --site dist/client/ && cp -r dist/client/pagefind .vercel/output/static/ && npm run test:function",
    "preview": "astro preview",
    "format": "prettier --write --cache '**/*.{js,jsx,ts,tsx,astro,html,css}'",
    "check": "astro check",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "test:function": "node --experimental-strip-types --test test/vercel-function.test.ts",
    "vercel-build": "mkdir -p .vercel/output/static/ && npm run build",
    "spellcheck:md": "cspell \"src/content/post/**/*.md\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.14",
    "@libsql/client": "^0.18.0",
    "@respectify/astro": "^1.0.1",
    "@respectify/client": "^0.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^1.6.1",
    "astro": "^7.3.8",
    "astro-icon": "^1.2.0",
    "astro-starlight-remark-asides": "^0.0.7",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^5.10.0",
    "rehype-external-links": "^3.0.0",
    "remark-directive": "^3.0.0",
    "satori": "^0.12.1",
    "satori-html": "^0.3.2",
    "sharp": "^0.33.3",
    "typescript-eslint": "^8.71.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^9.39.5",
    "@iconify-json/mdi": "^1.1.64",
    "@pagefind/default-ui": "^1.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "cspell": "^9.8.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^16.5.0",
    "mdast-util-to-string": "^4.0.0",
    "pagefind": "^1.5.2",
    "postcss": "^8.5.29",
    "postcss-html": "^1.6.0",
    "prettier": "^3.2.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "reading-time": "^1.5.0",
    "remark-unwrap-images": "^4.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.4.3"
  },
  "engines": {
    "node": "22.x"
  }
}
